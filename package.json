{
  "name": "ironshade-vector",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "scripts": {
    "dev": "vite",
    "test:beta": "tsc --noEmit && vite build --ssr tests/beta-level15.ts --outDir .beta-dist && node .beta-dist/beta-level15.js",
    "test:gameplay": "vite build --ssr tests/gameplay-regressions.ts --outDir .gameplay-dist && node .gameplay-dist/gameplay-regressions.js",
    "build": "npm run test:beta && npm run test:gameplay && npm run test:network && npm run test:service && npm run test:maps && npm run test:loot && npm run test:ui && npm run test:render && vite build && npm run test:bundle",
    "preview": "vite preview",
    "test:maps": "vite build --ssr tests/map-navigation.ts --outDir .map-dist && node .map-dist/map-navigation.js",
    "test:loot": "vite build --ssr tests/loot-difficulty.ts --outDir .loot-dist && node .loot-dist/loot-difficulty.js",
    "test:ui": "vite build --ssr tests/ui-readability.ts --outDir .ui-dist && node .ui-dist/ui-readability.js",
    "test:render": "vite build --ssr tests/render-performance.ts --outDir .render-dist && node .render-dist/render-performance.js",
    "test:bundle": "node tests/client-bundle-budget.mjs",
    "android:sync": "npx cap sync android",
    "test:service": "node tests/service-regressions.mjs",
    "test:network": "vite build --ssr tests/network-regressions.ts --outDir .network-dist && node .network-dist/network-regressions.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@netlify/blobs": "^11.1.0",
    "@netlify/functions": "^6.0.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.186.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
