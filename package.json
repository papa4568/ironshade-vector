    "test:enemy-t9-visuals-ii": "vite build --ssr tests/enemy-t9-visuals-ii.ts --outDir .enemy-t9-visuals-ii-dist && node .enemy-t9-visuals-ii-dist/enemy-t9-visuals-ii.js",
