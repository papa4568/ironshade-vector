    "test:information-audio": "vite build --ssr tests/information-mix-audio.ts --outDir .information-audio-dist && node .information-audio-dist/information-mix-audio.js",
    "test:player-handling-animation": "vite build --ssr tests/player-handling-animation.ts --outDir .player-handling-animation-dist && node .player-handling-animation-dist/player-handling-animation.js",
    "test:skill-damage-animation": "vite build --ssr tests/skill-damage-animation.ts --outDir .skill-damage-animation-dist && node .skill-damage-animation-dist/skill-damage-animation.js",
