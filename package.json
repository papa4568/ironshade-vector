{
  "name": "ironshade-vector",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "scripts": {
    "dev": "vite",
    "predev": "npm run prepare:graphics-codecs && npm run prepare:graphics-assets",
    "prepare:graphics-codecs": "node scripts/prepare-graphics-codecs.mjs",
    "test:beta": "tsc --noEmit && vite build --ssr tests/beta-level15.ts --outDir .beta-dist && node .beta-dist/beta-level15.js",
    "test:gameplay": "vite build --ssr tests/gameplay-regressions.ts --outDir .gameplay-dist && node .gameplay-dist/gameplay-regressions.js",
    "test:megastructure-continuity": "vite build --ssr tests/megastructure-environmental-continuity.ts --outDir .megastructure-continuity-dist && node .megastructure-continuity-dist/megastructure-environmental-continuity.js",
    "test:chapter3": "vite build --ssr tests/chapter3-playthrough.ts --outDir .chapter3-dist && node .chapter3-dist/chapter3-playthrough.js",
    "build": "npm run prepare:graphics-codecs && npm run prepare:graphics-assets && npm run test:beta && npm run test:gameplay && npm run test:endgame && npm run test:megastructure-continuity && npm run test:chapter3 && npm run test:network && npm run test:service && npm run test:maps && npm run test:loot && npm run test:gear-schema && npm run test:gear-power-axis && npm run test:gear-base-families && npm run test:gear-stat-registry && npm run test:gear-affix-rules && npm run test:gear-loot-generation && npm run test:gear-singular-audit && npm run test:ui && npm run test:render && npm run test:graphics && npm run test:graphics:content && vite build && npm run test:bundle:architecture && npm run test:graphics:dist",
    "preview": "vite preview",
    "test:maps": "vite build --ssr tests/map-navigation.ts --outDir .map-dist && node .map-dist/map-navigation.js",
    "test:loot": "vite build --ssr tests/loot-difficulty.ts --outDir .loot-dist && node .loot-dist/loot-difficulty.js",
    "test:gear-schema": "vite build --ssr tests/gear-schema.ts --outDir .gear-schema-dist && node .gear-schema-dist/gear-schema.js",
    "test:gear-power-axis": "vite build --ssr tests/gear-power-axis.ts --outDir .gear-power-axis-dist && node .gear-power-axis-dist/gear-power-axis.js",
    "test:gear-base-families": "vite build --ssr tests/gear-base-families.ts --outDir .gear-base-families-dist && node .gear-base-families-dist/gear-base-families.js",
    "test:gear-stat-registry": "vite build --ssr tests/gear-stat-registry.ts --outDir .gear-stat-registry-dist && node .gear-stat-registry-dist/gear-stat-registry.js",
    "test:gear-affix-rules": "vite build --ssr tests/gear-affix-rules.ts --outDir .gear-affix-rules-dist && node .gear-affix-rules-dist/gear-affix-rules.js",
    "test:gear-loot-generation": "vite build --ssr tests/gear-loot-generation.ts --outDir .gear-loot-generation-dist && node .gear-loot-generation-dist/gear-loot-generation.js",
    "test:ui": "vite build --ssr tests/ui-readability.ts --outDir .ui-dist && node .ui-dist/ui-readability.js",
    "test:render": "vite build --ssr tests/render-performance.ts --outDir .render-dist && node .render-dist/render-performance.js",
    "test:graphics": "vite build --ssr tests/graphics-asset-pipeline.ts --outDir .graphics-dist && node .graphics-dist/graphics-asset-pipeline.js",
    "test:graphics:content": "node tests/graphics-content-assets.mjs",
    "test:graphics:dist": "node tests/graphics-runtime-assets.mjs",
    "test:bundle:architecture": "node tests/client-bundle-architecture.mjs",
    "android:sync": "npx cap sync android",
    "test:service": "vite build --ssr tests/service-regressions.ts --outDir .service-dist --config vite.service.config.ts && node .service-dist/service-regressions.js",
    "test:network": "vite build --ssr tests/network-regressions.ts --outDir .network-dist && node .network-dist/network-regressions.js",
    "prepare:graphics-assets": "node scripts/prepare-graphics-assets.mjs",
    "test:endgame": "vite build --ssr tests/endgame-verification.ts --outDir .endgame-dist && node .endgame-dist/endgame-verification.js",
    "test:gear-singular-audit": "vite build --ssr tests/gear-singular-audit.ts --outDir .gear-singular-audit-dist && node .gear-singular-audit-dist/gear-singular-audit.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@netlify/blobs": "^11.1.0",
    "@netlify/functions": "^6.0.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.186.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
