  "proofProfiles": {
    "p28-visual-standard": [
      {
        "id": "targeted-regressions",
        "kind": "test",
        "required": true,
        "description": "Run the narrow task-specific regressions including route overlay geometry, shared world-object fallback/readiness and gameplay cue integrity when affected."
      },
      {
        "id": "production-build",
        "kind": "build",
        "required": true,
        "description": "The production client build and packaged graphics checks pass.",
        "command": "npm run build:prod"
      },
      {
        "id": "flagship-capture",
        "kind": "review",
        "required": true,
        "description": "Exact-candidate Flagship normal/action gameplay screenshots must receive direct image-content inspection, recorded actual location ID and live route/object material/fallback provenance under the campaign visual acceptance contract; PNG validity and telemetry alone are insufficient."
      },
      {
        "id": "candidate-ci",
        "kind": "ci",
        "required": true,
        "description": "Repository-required final browser/CI gates pass on the exact candidate revision."
      },
      {
        "id": "verified-apk",
        "kind": "artifact",
        "required": true,
        "description": "The exact candidate produces the required verified Android APK artifact."
      }
    ],
    "p28-performance-standard": [
      {
        "id": "targeted-regressions",
        "kind": "test",
        "required": true,
        "description": "Run focused deterministic performance/recovery regressions for the changed runtime path."
      },
      {
        "id": "production-build",
        "kind": "build",
        "required": true,
        "description": "The production client build and packaged graphics checks pass.",
        "command": "npm run build:prod"
      },
      {
        "id": "runtime-cost-evidence",
        "kind": "invariant",
        "required": true,
        "description": "Repository-visible runtime evidence proves the requested adaptive transition or bounded expensive-work behavior without substituting emulator timing for physical-phone acceptance."
      },
      {
        "id": "candidate-ci",
        "kind": "ci",
        "required": true,
        "description": "Repository-required final browser/CI gates pass on the exact candidate revision."
      },
      {
        "id": "verified-apk",
        "kind": "artifact",
        "required": true,
        "description": "The exact candidate produces the required verified Android APK artifact."
      }
    ]
  },
  "rules": [
    {
      "prefix": "P28-P",
      "affectedDomains": [
        "graphics",
        "performance",
        "runtime",
        "refinery"
      ],
      "proofProfile": "p28-performance-standard"
    },
    {
      "prefix": "P28-C",
      "affectedDomains": [
        "graphics",
        "refinery",
        "assets"
      ],
      "proofProfile": "p28-visual-standard"
    },
    {
      "prefix": "P28-D",
      "affectedDomains": [
