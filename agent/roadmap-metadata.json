        "required": true,
        "description": "Run the narrow task-specific regressions needed to disprove the implementation before final verification."
      },
      {
        "id": "production-build",
        "kind": "build",
        "required": true,
        "description": "The production client build and packaged graphics checks pass.",
        "command": "npm run build:prod"
      },
      {
