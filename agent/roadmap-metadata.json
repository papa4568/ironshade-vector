        "kind": "review",
        "required": true,
        "description": "Deterministic Flagship visual evidence required by the roadmap item is captured and remains gameplay-readable."
      },
      {
        "id": "candidate-ci",
        "kind": "ci",
        "required": true,
        "description": "Repository-required final browser/CI gates pass on the exact candidate revision."
      },
      {
        "id": "verified-apk",
        "kind": "artifact",
        "required": true,
        "description": "The exact candidate produces the required verified Android APK artifact."
      }
    ]
  },
