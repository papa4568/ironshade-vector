{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ironshade-vector.local/agent/candidate-manifest.schema.json",
  "title": "Ironshade Vector Candidate Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "task",
    "candidate",
    "changedFiles",
    "impact",
    "requiredProofs",
    "externalQaRefs"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "source", "acceptanceDigest", "affectedDomains"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "acceptanceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "affectedDomains": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseSha", "headSha", "branch"],
      "properties": {
        "baseSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "headSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "branch": { "type": "string", "minLength": 1 }
      }
    },
    "changedFiles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "escalated", "domains", "verificationIds", "unknownFiles", "escalationReasons"],
      "properties": {
        "mode": { "enum": ["none", "targeted", "full"] },
        "escalated": { "type": "boolean" },
        "domains": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "verificationIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "unknownFiles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "escalationReasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "requiredProofs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "required", "description"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["test", "build", "ci", "artifact", "review", "invariant", "external"] },
          "required": { "type": "boolean" },
          "description": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 }
        }
      }
    },
    "externalQaRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
