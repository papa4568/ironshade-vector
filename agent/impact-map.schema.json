{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ironshade-vector.local/schemas/impact-map.schema.json",
  "title": "Ironshade Vector Affected Verification Map",
  "type": "object",
  "required": [
    "schemaVersion",
    "fallback",
    "verifications",
    "rules"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "fallback": {
      "type": "object",
      "required": [
        "unknownDomains",
        "unknownVerificationIds",
        "highRiskVerificationIds"
      ],
      "properties": {
        "unknownDomains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unknownVerificationIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "highRiskVerificationIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "verifications": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/verification"
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "verification": {
      "type": "object",
      "required": [
        "command",
        "cost",
        "purpose"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "cost": {
          "enum": [
            "focused",
            "moderate",
            "full"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "include",
        "domains",
        "verificationIds",
        "risk"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "include": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verificationIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risk": {
          "enum": [
            "normal",
            "high"
          ]
        },
        "reason": {
          "type": "string"
        },
        "promotion": {
          "$ref": "#/$defs/promotion"
        }
      },
      "additionalProperties": false
    },
    "promotion": {
      "type": "object",
      "required": [
        "taskId",
        "sourceTaskId",
        "sourceCorpusPath",
        "sourceCorpusGitBlobSha",
        "sourceImpactMapGitBlobSha",
        "sourceCandidateSha",
        "sourceWorkflowRunId",
        "sourceArtifactId",
        "sourceArtifactDigest",
        "previousRisk",
        "disableEnvironmentVariable",
        "disabledValue"
      ],
      "properties": {
        "taskId": {
          "type": "string",
          "pattern": "^EV-[0-9]+$"
        },
        "sourceTaskId": {
          "type": "string",
          "pattern": "^EV-[0-9]+$"
        },
        "sourceCorpusPath": {
          "type": "string",
          "minLength": 1
        },
        "sourceCorpusGitBlobSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "sourceImpactMapGitBlobSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "sourceCandidateSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "sourceWorkflowRunId": {
          "type": "integer",
          "minimum": 1
        },
        "sourceArtifactId": {
          "type": "integer",
          "minimum": 1
        },
        "sourceArtifactDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "previousRisk": {
          "enum": [
            "normal"
          ]
        },
        "disableEnvironmentVariable": {
          "type": "string",
          "minLength": 1
        },
        "disabledValue": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
