{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ironshade-vector.local/agent/impact-calibration.schema.json",
  "title": "Ironshade impact-map calibration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "confidence", "trustedObservations"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "mode": { "const": "advisory" },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumTrustedFailureObservations", "failClosedThreshold"],
      "properties": {
        "minimumTrustedFailureObservations": { "type": "integer", "minimum": 1, "maximum": 100 },
        "failClosedThreshold": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "trustedObservations": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/observation" }
    }
  },
  "$defs": {
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "domains", "verificationIds", "pathFamilies"],
      "properties": {
        "mode": { "enum": ["none", "targeted", "full"] },
        "domains": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "verificationIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "pathFamilies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "fullVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "failedScript", "observedVerificationIds", "observedDomains"],
      "properties": {
        "outcome": { "enum": ["success", "failure", "skipped", "cancelled"] },
        "failedScript": { "type": ["string", "null"] },
        "observedVerificationIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "observedDomains": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["falseNegative", "reason"],
      "properties": {
        "falseNegative": { "type": "boolean" },
        "reason": { "type": ["string", "null"] }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "candidateSha",
        "changedFiles",
        "prediction",
        "fullVerification",
        "comparison",
        "trustedForCalibration"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "enum": ["candidate", "historical", "synthetic"] },
        "candidateSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "changedFiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "prediction": { "$ref": "#/$defs/prediction" },
        "fullVerification": { "$ref": "#/$defs/fullVerification" },
        "comparison": { "$ref": "#/$defs/comparison" },
        "trustedForCalibration": { "type": "boolean" }
      }
    }
  }
}
