{
  "schemaVersion": 1,
  "mode": "advisory",
  "taskId": "EV-17",
  "promotionTarget": "EV-18",
  "errorBudget": {
    "falseHits": 0,
    "sameClosureDisagreements": 0
  },
  "minimumSameClosureRuns": 2,
  "proofClasses": [
    {
      "proofId": "full-repository-build",
      "expectedCommand": "npm run build",
      "expectedRepositoryClosure": {
        "strategy": "all-tracked-except",
        "excludedPrefixes": [
          ".github/",
          "agent/",
          "android/",
          "docs/"
        ],
        "excludedFiles": [
          "scripts/android-large-screen-smoke.sh",
          "scripts/run-behavioral-genome-shadow.mjs",
          "tests/behavioral-genome-route.ts"
        ]
      },
      "expectedRuntimeClosure": {
        "runnerLabel": "ubuntu-24.04",
        "captureNode": true,
        "captureNpm": true,
        "capturePlatform": true,
        "environmentVariables": [
          "ImageOS",
          "ImageVersion",
          "VITE_API_BASE_URL"
        ]
      },
      "requiredEnvironmentInputs": [
        "runner-image-os",
        "runner-image-version",
        "node-version",
        "npm-version",
        "platform",
        "architecture",
        "VITE_API_BASE_URL",
        "docker-base-image-identity",
        "docker-engine-version"
      ],
      "knownClosureGaps": [
        {
          "id": "docker-base-image-identity-not-bound",
          "input": "docker-base-image-identity",
          "reason": "The authoritative proof now shares one repository-closed Docker execution script with EV-17, but EV-6 does not bind the immutable pulled node:22.23.2-bookworm image identity into its execution-context digest.",
          "blocksEligibility": true
        },
        {
          "id": "docker-engine-version-not-bound",
          "input": "docker-engine-version",
          "reason": "The authoritative proof executes through Docker, but EV-6 does not bind the Docker engine version into its execution-context digest.",
          "blocksEligibility": true
        }
      ],
      "probes": [
        {
          "id": "same-closure-excluded-set-control",
          "kind": "same-closure-control",
          "mutations": [
            {
              "targetPath": ".github/workflows/agent-orchestration.yml",
              "mutationSuffix": "\n# EV-17 disposable excluded .github control\n"
            },
            {
              "targetPath": "agent/INDEPENDENT_VERIFIER.md",
              "mutationSuffix": "\n<!-- EV-17 disposable excluded agent control -->\n"
            },
            {
              "targetPath": "android/.ev17-excluded-control",
              "createContent": "EV-17 disposable excluded android control\n"
            },
            {
              "targetPath": "docs/experimental-verification-roadmap.md",
              "mutationSuffix": "\n<!-- EV-17 disposable excluded docs control -->\n"
            },
            {
              "targetPath": "scripts/android-large-screen-smoke.sh",
              "mutationSuffix": "\n# EV-17 disposable excluded file control\n"
            },
            {
              "targetPath": "scripts/run-behavioral-genome-shadow.mjs",
              "mutationSuffix": "\n// EV-17 disposable excluded file control\n"
            },
            {
              "targetPath": "tests/behavioral-genome-route.ts",
              "mutationSuffix": "\n// EV-17 disposable excluded file control\n"
            }
          ],
          "expectedClosureRelation": "same",
          "expectedOutcome": "success",
          "expectedPrediction": "hit"
        },
        {
          "id": "included-benign-source-control",
          "kind": "invalidation-control",
          "mutations": [
            {
              "targetPath": "src/main.tsx",
              "mutationSuffix": "\n// EV-17 disposable benign proof-cache invalidation control\n"
            }
          ],
          "expectedClosureRelation": "different",
          "expectedOutcome": "success",
          "expectedPrediction": "miss",
          "expectedClassification": "false-miss"
        },
        {
          "id": "included-source-defect",
          "kind": "invalidation-defect",
          "mutations": [
            {
              "targetPath": "src/main.tsx",
              "mutationSuffix": "\nconst __ev17ProofCacheTypeFailure: string = 17;\n"
            }
          ],
          "expectedClosureRelation": "different",
          "expectedOutcome": "failure",
          "expectedPrediction": "miss",
          "expectedClassification": "correct-invalidation",
          "expectedFailurePattern": "Type 'number' is not assignable to type 'string'"
        }
      ],
      "calibrationCommand": "bash scripts/run-full-repository-build-proof.sh",
      "executionProfilePath": "scripts/run-full-repository-build-proof.sh"
    }
  ]
}
