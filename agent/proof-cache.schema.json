{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ironshade-vector.local/agent/proof-cache.schema.json",
  "title": "Ironshade causal proof cache policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "proofClasses"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "mode": { "const": "shadow" },
    "proofClasses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/proofClass" }
    }
  },
  "$defs": {
    "proofClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "expensive", "repositoryClosure", "runtimeClosure"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "expensive": { "const": true },
        "repositoryClosure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "excludedPrefixes", "excludedFiles"],
          "properties": {
            "strategy": { "const": "all-tracked-except" },
            "excludedPrefixes": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "excludedFiles": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "runtimeClosure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runnerLabel", "captureNode", "captureNpm", "capturePlatform", "environmentVariables"],
          "properties": {
            "runnerLabel": { "type": "string", "minLength": 1 },
            "captureNode": { "const": true },
            "captureNpm": { "const": true },
            "capturePlatform": { "const": true },
            "environmentVariables": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "historyObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "proofId", "candidateSha", "repositoryDigest", "executionContextDigest", "closureDigest", "outcome", "workflowRunId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "const": "candidate-rerun" },
        "proofId": { "type": "string", "minLength": 1 },
        "candidateSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "repositoryDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "executionContextDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "closureDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "outcome": { "enum": ["success", "failure", "skipped", "cancelled"] },
        "workflowRunId": { "type": "string", "pattern": "^[0-9]+$" }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "mode", "observations"],
      "properties": {
        "$schema": { "type": "string" },
        "schemaVersion": { "const": 1 },
        "mode": { "const": "shadow" },
        "observations": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/historyObservation" }
        }
      }
    }
  }
}
